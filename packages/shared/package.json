{
  "name": "kuxi-shared",
  "version": "0.2.3",
  "type": "module",
  "description": "库犀 KuXi 跨包共享的类型与常量（零运行时依赖），供 kuxi-core / kuxi-mcp 使用",
  "keywords": [
    "kuxi",
    "库犀",
    "types",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITxuezhe/kuxi.git"
  },
  "homepage": "https://github.com/ITxuezhe/kuxi",
  "bugs": {
    "url": "https://github.com/ITxuezhe/kuxi/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
