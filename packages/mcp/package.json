{
  "name": "@itxuezhe/mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "库犀 MCP server：把 @itxuezhe/core 以标准 MCP 工具暴露给 Claude / Cursor 等 AI 客户端（stdio），npx @itxuezhe/mcp 一行接入",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup",
    "test": "tsx src/test/tools.ts && tsx src/test/e2e.ts"
  },
  "dependencies": {
    "@itxuezhe/core": "workspace:*",
    "@itxuezhe/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "kuxi-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
