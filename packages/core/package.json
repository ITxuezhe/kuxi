{
  "name": "kuxi-core",
  "version": "0.2.3",
  "type": "module",
  "description": "库犀 KuXi 无头数据库引擎：驱动、连接管理、SQL 分类、数据管线、插件（Node >= 22.13，可脱离桌面端复用）",
  "keywords": [
    "database",
    "sql",
    "sqlite",
    "mysql",
    "postgresql",
    "pipeline",
    "kuxi",
    "库犀"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITxuezhe/kuxi.git"
  },
  "homepage": "https://github.com/ITxuezhe/kuxi",
  "bugs": {
    "url": "https://github.com/ITxuezhe/kuxi/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsx src/test/smoke.ts && tsx src/test/pipeline.ts && tsx src/test/script-node.ts && tsx src/test/host.ts",
    "harness": "tsx src/test/harness-demo.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "kuxi-shared": "workspace:*",
    "mysql2": "^3.11.3",
    "pg": "^8.13.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
